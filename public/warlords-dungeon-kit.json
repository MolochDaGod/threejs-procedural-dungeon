{
  "version": "2.1.1",
  "product": "warlords",
  "cdn": "https://assets.grudge-studio.com",
  "note": "Game-ready dungeon kit compiled from D1 gn_assets (tag=dungeon) + cave contracts + Rapier/nav contract. No new host.",
  "d1": {
    "database": "grudge-objectstore",
    "tables": ["gn_assets", "gn_asset_tags", "world_dungeons", "dungeon_kit_pieces"],
    "dungeonTagged": 192,
    "source": "game-assets/glb/kaykit"
  },
  "generation": {
    "algorithm": "scatter-separate-delaunay-mst-carve-bfs",
    "deterministic": "mulberry32",
    "cellM": 2,
    "linearDefault": { "rooms": 16, "loops": 0, "path": "critical" },
    "graphDefault": { "rooms": 42, "loopChance": 0.15 },
    "themes": ["ancient", "molten", "frost", "grim", "verdant"],
    "host": "three.js client + node instance server",
    "instance": {
      "version": 1,
      "maxPlayers": 8,
      "payload": "src/gen/instance.js dungeonToInstance"
    }
  },
  "navmesh": {
    "generated": { "kind": "grid-8", "cellM": 2, "walkable": "FLOOR", "blocked": ["WALL", "VOID", "POOL"], "stringPull": true },
    "authoredInteriors": {
      "kind": "floor-name-sample",
      "contract": "grudge-builder/shared/definitions/caveDungeonContract.ts",
      "floorNamePatterns": ["floor", "ground", "walk", "path", "stone", "dirt"]
    }
  },
  "physics": {
    "engine": "rapier3d-compat",
