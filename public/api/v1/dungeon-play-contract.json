{
  "schema": "grudge.dungeon.play/v1",
  "host": "grudge-dungeons",
  "live": "https://grudge-dungeons.vercel.app/",
  "kinds": {
    "biome": "Theme roster + authored creatures (rock, berserk, troll, cave dino). Telegraphs cone / incoming / aoe.",
    "faction": "Hostile Warlords faction Toon kits at 1.5× with boss-like attacks.",
    "boss": "Empty halls. One warlord arena."
  },
  "loads": {
    "player": "CDN Toon {race}.glb, one mixer, Bip001 clips",
    "creatures": "/models/creatures/{id}.glb native clips + embedded textures",
    "entrance": "KayKit door/gate on the wall — not 2cave.glb",
    "physics": "Rapier CCT lazy on ENTER; BVH sampler at groundY=0",
    "cover": "pillars / interior walls / debris BLOCK + halloween staged BARRIER",
    "allies": "tank taunt/parry · priest heal · ranger DPS · worge utility"
  },
  "telegraphs": ["cone", "linear", "incoming", "aoe", "column", "charge"],
  "skills": {
    "math": "src/play/t0ClassSets.js CATALOG_SKILL_PLAY — catalog ids only",
    "icons": "info.grudge-studio.com/api/v1/master-weaponSkills.json + assets.grudge-studio.com/icons",
    "skillApi": "https://weapon-skills.grudge-studio.com/api/health + /api/v1/bundle (drafts, not catalog)",
    "trees": "https://info.grudge-studio.com/api/v1/master-skillTrees.json",
    "prefabs": "https://info.grudge-studio.com/api/v1/master-weapon-prefabs.json",
    "uuidLaw": "https://info.grudge-studio.com/api/v1/uuid-law.json",
    "manifest": "https://info.grudge-studio.com/api/v1/game-data-manifest.json",
    "canonicalManifest": "https://info.grudge-studio.com/api/v1/canonical-manifest.json",
    "projectiles": "assets.grudge-studio.com/models/vfx/orbs/orb-{element}.glb SI 0.45 m — never whole fireball.glb",
    "fissure": "isolated magic-rock-N",
    "slashResidual": "linear.wave Getsuga on heavy melee"
  },
  "camera": {
    "forge": "orthographic",
    "crawl": "owned shoulder TPS boom 4.6 m, no OrbitControls",
    "file": "src/play/tpsCamera.js"
  },
  "animation": {
    "mixer": "one per Actor",
    "donor": "https://combat.grudge-studio.com/models/toon-clips/wk-knight.glb",
    "classify": "src/play/clipRoles.js",
    "gait": "idle/walk/run/sprint overlay; gs_* on 2H; sneak/crawl/strafe",
    "hitWindow": "slash 0.32 * clip.duration, projectile 0.22 * clip.duration",
    "missing": ["hit", "stun", "magic_cast", "bow_shot", "death"],
    "ban": "three-player-controller package; second mixer; attack-as-flinch"
  },
  "hud": {
    "portraits": "24 lore heroes + Racalvin, John Wayne, Scoujge Faithbear",
    "objective": "START at entrance · COMPLETE on warlord slain"
  },
  "complete": {
    "on": "boss-slain",
    "pass": "dungeon-complete",
    "not": "all-enemies-dead",
    "report": "/api/dungeon/complete",
    "return": "https://grudgewarlords.com/home"
  },
  "script": {
    "compile": "/api/dungeon/script",
    "schema": "grudge.dungeon.script/v1",
    "events": ["awaken_on_enter", "clear_gate", "boss_phases", "event_platforms", "pool_hazard", "telegraph_all"]
  },
  "handoff": "?characterId=<uuid>&era=warlords&from=home&linear=1&race=&class=",
  "ids": {
    "characterId": "RFC UUID characters.id — play PK",
    "grudge_id": "GRUDGE_… account — bag/wallet, never handoff",
    "grudge_code": "GRDG-… display stamp — never handoff",
    "t8": "ITEM-… ObjectStore prefab catalog, not ledger grudge_uuid",
    "sessionBag": "crawl yield only — no client-minted grudge_uuid"
  },
  "node": "npm start → server/index.mjs",
  "note": "One generateDungeon. kind only changes planEncounters. Enemies may spawn in more than one biome."
}
